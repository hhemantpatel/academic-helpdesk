# Copy to .env (read by helpdesk/config.py)
OLLAMA_API_BASE=http://localhost:11434
DEFAULT_CHAT_MODEL=ollama_chat/qwen3:8b
LLAMA_CHAT_MODEL=ollama_chat/llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
HELPDESK_TAU=0.35          # retrieval cosine-distance threshold
HELPDESK_NUM_CTX=8192      # context window requested from Ollama per call
